{
  "name": "dsh-plugin-control-your-video",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A DeepSeek Harness plugin that lets the assistant actually make videos: one preset, 13 method skills, an evidence tool and an optional workspace asset library.",
  "license": "MIT",
  "engines": {
    "node": ">=22.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "tools",
    "tests",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
