{
  "name": "dsh-plugin-control-your-video",
  "version": "0.1.0",
  "private": true,
  "description": "AI video creation workbench for DeepSeek Harness: project, creation and work surfaces for open-ended video works.",
  "type": "module",
  "main": "./ui/plugin/host.js",
  "exports": {
    ".": "./ui/plugin/host.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./ui/plugin/client.js",
    "./base": "./base/index.js",
    "./base/*": "./base/*.js",
    "./core/project": "./core/project/index.js",
    "./tools": "./tools/index.js",
    "./media": "./media/index.js"
  },
  "files": [
    "ui/host",
    "ui/client",
    "ui/plugin",
    "core/project/*.js",
    "tools/*.js",
    "base",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "media/*.js",
    "media/render",
    "media/ops"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs all",
    "test:unit": "node scripts/test.mjs unit",
    "test:contract": "node scripts/test.mjs contract",
    "test:integration": "node scripts/test.mjs integration",
    "test:acceptance": "node scripts/test.mjs acceptance",
    "lint": "node scripts/static-check.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "verify": "node scripts/verify.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "deps:report": "node scripts/deps-report.mjs",
    "check": "node scripts/verify.mjs"
  },
  "license": "MIT"
}
