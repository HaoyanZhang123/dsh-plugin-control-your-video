{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/host",
    "outDir": "lib/host",
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/host/**/*.ts"]
}
